# ─── Plush Comfort UK — VERCEL (subdomain) + Neon PostgreSQL ───
# Put these in Vercel → Project → Settings → Environment Variables, then Redeploy.

# Your subdomain, e.g. https://shop.plushcomfort.uk
SITE_URL=https://shop.plushcomfort.uk

# Neon → Connect → Connection pooling ON (host contains -pooler)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require

# Subdomain copy of the store → hide from Google so it does not compete with plushcomfort.uk
# (set false only if this deployment becomes the main, indexed site)
NOINDEX=true

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@plushcomfort.uk
SMTP_PASS=
SMTP_FROM="Plush Comfort UK <no-reply@plushcomfort.uk>"

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en_GB
